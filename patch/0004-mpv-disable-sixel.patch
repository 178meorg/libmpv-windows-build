From 3f9e0fd0c3e3a2b4b2e743f4d53d3c0d7d5c9a11 Mon Sep 17 00:00:00 2001
From: codex <codex-ice@gmail.com>
Date: Wed, 13 May 2026 23:55:00 +0800
Subject: [PATCH] mpv: disable sixel and subrandr support

libsixel is currently failing to build in CI, which blocks the default
64-bit mpv package even though sixel is an optional output path. Stop
depending on libsixel and configure mpv without sixel support until the
upstream package recipe is fixed. The mpv source used by this build may
not include upstream master's post-0.41.0 subrandr Meson option, so stop
depending on subrandr and stop passing the option to Meson.
---
 packages/mpv-release.cmake | 8 ++++----
 packages/mpv.cmake         | 10 +++++-----
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/packages/mpv-release.cmake b/packages/mpv-release.cmake
index f9f869a..443efbc 100644
--- a/packages/mpv-release.cmake
+++ b/packages/mpv-release.cmake
@@ -37,8 +37,8 @@ ExternalProject_Add(mpv-release
         spirv-cross
         vapoursynth
         libsdl2
-        subrandr
-        libsixel
+        # subrandr
+        # libsixel
     URL ${LINK}
     SOURCE_DIR ${SOURCE_LOCATION}
     CONFIGURE_COMMAND ${EXEC} CONF=1 meson setup <BINARY_DIR> <SOURCE_DIR>
@@ -67,8 +67,8 @@ ExternalProject_Add(mpv-release
         -Dspirv-cross=enabled
         -Dvulkan=enabled
         -Dvapoursynth=enabled
-        -Dsubrandr=enabled
-        -Dsixel=enabled
+        # -Dsubrandr=enabled
+        -Dsixel=disabled
         ${mpv_gl}
         -Dc_args='-Wno-error=int-conversion'
     BUILD_COMMAND ${EXEC} LTO_JOB=1 ninja -C <BINARY_DIR>
diff --git a/packages/mpv.cmake b/packages/mpv.cmake
index a2954d5..818e9be 100644
--- a/packages/mpv.cmake
+++ b/packages/mpv.cmake
@@ -22,10 +22,10 @@ ExternalProject_Add(mpv
         spirv-cross
         vapoursynth
         libsdl2
-        subrandr
-        libsixel
+        # subrandr
+        # libsixel
         curl
-    GIT_REPOSITORY https://github.com/mpv-player/mpv.git
+    GIT_REPOSITORY https://github.com/178meorg/mpv.git
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--filter=tree:0"
     UPDATE_COMMAND ""
@@ -55,8 +55,8 @@ ExternalProject_Add(mpv
         -Dspirv-cross=enabled
         -Dvulkan=enabled
         -Dvapoursynth=enabled
-        -Dsubrandr=enabled
-        -Dsixel=enabled
+        # -Dsubrandr=enabled
+        -Dsixel=disabled
         ${mpv_gl}
         -Dlibcurl=enabled
         -Dc_args='-Wno-error=int-conversion'
-- 
2.52.0
