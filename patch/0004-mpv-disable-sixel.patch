From 7192a1bc1020087e0b7dcca15ac03aa4771fe299 Mon Sep 17 00:00:00 2001
From: codex <codex-ice@gmail.com>
Date: Tue, 17 Nov 2026 10:45:28 +0800
Subject: [PATCH] mpv: use custom fork and disable unsupported optional
 features

Build 178meorg/mpv while preserving its mpv 0.41-compatible options.
Disable the failing libsixel dependency and omit the newer subrandr and
libcurl Meson options that this fork does not provide.
---
 packages/mpv-release.cmake |  8 ++++----
 packages/mpv.cmake         | 11 +++++------
 2 files changed, 9 insertions(+), 10 deletions(-)

diff --git a/packages/mpv-release.cmake b/packages/mpv-release.cmake
index f9f869a..443efbc 100644
--- a/packages/mpv-release.cmake
+++ b/packages/mpv-release.cmake
@@ -37,8 +37,8 @@ ExternalProject_Add(mpv-release
         spirv-cross
         vapoursynth
         libsdl2
-        subrandr
-        libsixel
+        # subrandr
+        # libsixel
     URL ${LINK}
     SOURCE_DIR ${SOURCE_LOCATION}
     CONFIGURE_COMMAND ${EXEC} CONF=1 meson setup <BINARY_DIR> <SOURCE_DIR>
@@ -67,8 +67,8 @@ ExternalProject_Add(mpv-release
         -Dspirv-cross=enabled
         -Dvulkan=enabled
         -Dvapoursynth=enabled
-        -Dsubrandr=enabled
-        -Dsixel=enabled
+        # -Dsubrandr=enabled
+        -Dsixel=disabled
         ${mpv_gl}
         -Dc_args='-Wno-error=int-conversion'
     BUILD_COMMAND ${EXEC} LTO_JOB=1 ninja -C <BINARY_DIR>
diff --git a/packages/mpv.cmake b/packages/mpv.cmake
index a2954d5..5f64438 100644
--- a/packages/mpv.cmake
+++ b/packages/mpv.cmake
@@ -22,10 +22,10 @@ ExternalProject_Add(mpv
         spirv-cross
         vapoursynth
         libsdl2
-        subrandr
-        libsixel
+        # subrandr
+        # libsixel
         curl
-    GIT_REPOSITORY https://github.com/mpv-player/mpv.git
+    GIT_REPOSITORY https://github.com/178meorg/mpv.git
     SOURCE_DIR ${SOURCE_LOCATION}
     GIT_CLONE_FLAGS "--filter=tree:0"
     UPDATE_COMMAND ""
@@ -55,10 +55,9 @@ ExternalProject_Add(mpv
         -Dspirv-cross=enabled
         -Dvulkan=enabled
         -Dvapoursynth=enabled
-        -Dsubrandr=enabled
-        -Dsixel=enabled
+        # -Dsubrandr=enabled
+        -Dsixel=disabled
         ${mpv_gl}
-        -Dlibcurl=enabled
         -Dc_args='-Wno-error=int-conversion'
     BUILD_COMMAND ${EXEC} LTO_JOB=1 PDB=1 ninja -C <BINARY_DIR>
     INSTALL_COMMAND ""
-- 
2.56.1
