From 92ad55621d2381cc73c233a7326876d940339d29 Mon Sep 17 00:00:00 2001
From: codex <codex-ice@gmail.com>
Date: Tue, 17 Nov 2026 10:58:17 +0800
Subject: [PATCH] mpv: build the resolved master commit

Track master explicitly and use the commit resolved by the workflow for the source checkout. Local builds without the workflow sha continue to follow origin/master.
---
 packages/mpv.cmake | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/packages/mpv.cmake b/packages/mpv.cmake
index a8139bb..01ba82a 100644
--- a/packages/mpv.cmake
+++ b/packages/mpv.cmake
@@ -23,6 +23,9 @@ ExternalProject_Add(mpv
         curl
     GIT_REPOSITORY https://github.com/178meorg/mpv.git
     SOURCE_DIR ${SOURCE_LOCATION}
+    GIT_REMOTE_NAME origin
+    GIT_TAG master
+    GIT_RESET "$ENV{sha}"
     GIT_CLONE_FLAGS "--filter=tree:0"
     UPDATE_COMMAND ""
     CONFIGURE_COMMAND ${EXEC} CONF=1 meson setup <BINARY_DIR> <SOURCE_DIR>
-- 
2.56.1
